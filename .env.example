# Environment Variables Template for DragonFill
# Copy this file to .env and fill in your actual values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Google Gemini AI Configuration
VITE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_GEMINI_MODEL=gemini-2.0-flash-exp

# OpenAI Configuration
VITE_OPENAI_API_KEY=your-openai-api-key-here
VITE_OPENAI_MODEL=gpt-4.1-mini
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Prompt Graph runtime policies
VITE_LLM_MAX_RETRIES=2
VITE_LLM_TIMEOUT_MS=18000
VITE_LLM_MAX_REQUESTS_PER_MINUTE=20
VITE_LLM_MAX_COST_PER_MINUTE_USD=1.2
VITE_PROMPT_GRAPH_ALLOWED_DOMAINS=
VITE_PROMPT_GRAPH_BLOCKED_DOMAINS=

# Application Settings
VITE_APP_ENV=development
